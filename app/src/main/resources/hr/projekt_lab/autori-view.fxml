<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" userData="authors" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.projekt_lab.controlleri.AutorController">
    <left>
        <fx:include source="sidebar-component.fxml" />
    </left>
    <center>
        <HBox spacing="12.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Button fx:id="editButton" mnemonicParsing="false" onAction="#editButtonOnAction" />
                                <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteButtonOnAction" />
                            </children>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Button fx:id="showAllButton" mnemonicParsing="false" onAction="#showAllButtonOnAction" />
                                <TextField fx:id="nationalityField" prefWidth="280.0" />
                                <Button fx:id="searchButton" mnemonicParsing="false" onAction="#searchButtonOnAction" />
                            </children>
                        </HBox>
                        <TableView fx:id="authorsTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="firstNameColumn" sortable="true" />
                                <TableColumn fx:id="lastNameColumn" sortable="true" />
                                <TableColumn fx:id="yearColumn" sortable="true" />
                                <TableColumn fx:id="nationalityColumn" sortable="true" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                <VBox alignment="TOP_CENTER" prefWidth="260.0" spacing="12.0" styleClass="cover-panel">
                    <padding>
                        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                    </padding>
                    <children>
                        <Text fx:id="selectedAuthorPanelTitle" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="panel-section-title" text="Odabrani autor" />
                        <ImageView fx:id="authorPhotoImageView" fitHeight="320.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true" />
                        <Label fx:id="authorPhotoPlaceholderLabel" styleClass="cover-placeholder" text="Odaberite autora" wrapText="true" />
                        <Label fx:id="selectedAuthorNameLabel" styleClass="cover-book-title" text="-" wrapText="true" />
                        <Label fx:id="selectedAuthorDetailsLabel" styleClass="cover-book-author" text="-" wrapText="true" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>
