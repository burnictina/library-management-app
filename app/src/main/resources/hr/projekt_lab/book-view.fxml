<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="768.0" prefWidth="1024.0" userData="books" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.projekt_lab.controlleri.BookController">
   <left>
      <fx:include source="sidebar-component.fxml" />
   </left>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button fx:id="editButton" mnemonicParsing="false" onAction="#editButtonOnAction" />
                  <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteButtonOnAction" />
                  <Button fx:id="loanForSelectedBookButton" mnemonicParsing="false" onAction="#loanForSelectedBookButtonOnAction" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <ComboBox fx:id="criteriaComboBox" prefHeight="28.0" prefWidth="180.0" />
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="searchField" prefWidth="280.0" />
                        <Button fx:id="searchButton" mnemonicParsing="false" onAction="#searchButtonOnAction" />
                     </children>
                  </HBox>
                  <Button fx:id="ispisiButton" mnemonicParsing="false" onAction="#ispisiButtonOnAction" />
                  <ProgressIndicator fx:id="loadingIndicator" maxHeight="24.0" maxWidth="24.0" visible="false" />
                  <Label fx:id="loadingLabel" text="Učitavanje podataka..." visible="false" />
               </children>
            </HBox>
            <HBox spacing="12.0" VBox.vgrow="ALWAYS">
               <children>
                  <TableView fx:id="knjigeTablica" prefWidth="760.0" HBox.hgrow="ALWAYS">
                    <columns>
                                 <TableColumn fx:id="naslovColumn" prefWidth="204.0" sortable="true" />
                                 <TableColumn fx:id="autorColumn" prefWidth="204.0" sortable="true" />
                                    <TableColumn fx:id="godIzdaColumn" prefWidth="204.0" sortable="true" />
                                    <TableColumn fx:id="isbnColumn" prefWidth="204.0" sortable="true" />
                                    <TableColumn fx:id="zanrColumn" prefWidth="204.0" sortable="true" />
                    </columns>
                  </TableView>
                  <VBox alignment="TOP_CENTER" prefWidth="260.0" spacing="12.0" styleClass="cover-panel">
                     <padding>
                        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                     </padding>
                     <children>
                        <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="panel-section-title" text="Odabrana knjiga" />
                        <ImageView fx:id="coverImageView" fitHeight="320.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true" />
                        <Label fx:id="coverPlaceholderLabel" styleClass="cover-placeholder" text="Odaberite knjigu" wrapText="true" />
                        <Label fx:id="selectedBookTitleLabel" styleClass="cover-book-title" text="-" wrapText="true" />
                        <Label fx:id="selectedBookAuthorLabel" styleClass="cover-book-author" text="-" wrapText="true" />
                        <Label fx:id="selectedBookAvailabilityLabel" styleClass="cover-book-author" text="Dostupno: -/-" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
