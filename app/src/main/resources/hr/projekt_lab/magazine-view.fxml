<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" userData="magazines" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.projekt_lab.controlleri.MagazineController">
  <left>
    <fx:include source="sidebar-component.fxml" />
  </left>
    <center>
      <VBox spacing="8.0" BorderPane.alignment="CENTER">
        <padding>
          <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
        </padding>
        <children>
          <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
              <Button fx:id="ispisiButton" mnemonicParsing="false" onAction="#showAllButtonOnAction" />
              <Button fx:id="editButton" mnemonicParsing="false" onAction="#editButtonOnAction" />
              <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteButtonOnAction" />
            </children>
          </HBox>
          <TableView fx:id="magazineTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <columns>
              <TableColumn fx:id="titleColumn" sortable="true" />
              <TableColumn fx:id="publisherColumn" sortable="true" />
              <TableColumn fx:id="issueNumberColumn" sortable="true" />
              <TableColumn fx:id="issueYearColumn" sortable="true" />
              <TableColumn fx:id="issueMonthColumn" sortable="true" />
              <TableColumn fx:id="categoryColumn" sortable="true" />
            </columns>
          </TableView>
        </children>
      </VBox>
   </center>
</BorderPane>
