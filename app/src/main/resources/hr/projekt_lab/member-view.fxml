<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" userData="members" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.projekt_lab.controlleri.MemberController">
   <left>
      <fx:include source="sidebar-component.fxml" />
   </left>
   <center>
      <VBox spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button fx:id="showAllButton" mnemonicParsing="false" onAction="#showAllButtonAction" />
                  <Button fx:id="editButton" mnemonicParsing="false" onAction="#editButtonAction" />
                  <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#deleteButtonAction" />
                  <Button fx:id="exportReportButton" mnemonicParsing="false" onAction="#exportReportButtonAction" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <ComboBox fx:id="criteriaComboBox" prefHeight="28.0" prefWidth="160.0" />
                  <TextField fx:id="searchField" prefHeight="28.0" HBox.hgrow="ALWAYS" />
                  <Button fx:id="searchButton" mnemonicParsing="false" onAction="#searchButtonAction" />
               </children>
            </HBox>
            <TableView fx:id="membersTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="idColumn" sortable="true" />
                  <TableColumn fx:id="firstNameColumn" sortable="true" />
                  <TableColumn fx:id="lastNameColumn" sortable="true" />
                  <TableColumn fx:id="joinDateColumn" sortable="true" />
                  <TableColumn fx:id="loansCountColumn" sortable="true" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
