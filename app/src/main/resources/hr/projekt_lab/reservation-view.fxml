<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1024.0" userData="reservations" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hr.projekt_lab.controlleri.ReservationController">
   <left>
      <fx:include source="sidebar-component.fxml" />
   </left>
   <center>
      <VBox spacing="8.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button fx:id="refreshButton" mnemonicParsing="false" onAction="#refreshButtonAction" />
               </children>
            </HBox>
            <TableView fx:id="reservationsTable" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="memberColumn" prefWidth="240.0" sortable="true" />
                  <TableColumn fx:id="bookColumn" prefWidth="260.0" sortable="true" />
                  <TableColumn fx:id="reservationDateColumn" prefWidth="180.0" sortable="true" />
                  <TableColumn fx:id="statusColumn" prefWidth="160.0" sortable="true" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
</BorderPane>
